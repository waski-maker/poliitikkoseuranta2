# Static web UI + reverse proxy for the API on the same domain.
# Set DOMAIN (e.g. seuranta.example.fi) for automatic HTTPS; defaults to :80.
{$DOMAIN::80} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8787
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
