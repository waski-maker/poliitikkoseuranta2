# =============================================================================
# Poliitikkoseuranta – ympäristömuuttujat
# `pnpm run setup` kopioi tämän tiedostoon .env ja luo salaiset avaimet.
# .env-tiedostoa ei koskaan commitoida. Selaimeen menevät vain VITE_-alkuiset.
# =============================================================================

# --- Yleiset -----------------------------------------------------------------
# Lokitaso: debug | info | warn | error
LOG_LEVEL=info

# --- Tietokanta (PostgreSQL 15+, laajennukset pgvector ja pg_trgm) -----------
# Paikallisesti Docker Compose: postgres://postgres:postgres@localhost:5432/ps_dev
# Supabase: Project Settings → Database → Connection string (URI). Edge Functionissa
# käytetään automaattisesti SUPABASE_DB_URL-arvoa, jos tämä puuttuu.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ps_dev
# Yhteyspoolin koko API:lle ja työntekijälle.
DATABASE_POOL_MAX=5
# Automaattisten testien tietokanta (tyhjennetään testeissä!).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ps_test

# --- Osoitteet -----------------------------------------------------------------
# Käyttöliittymän osoite (CORS ja kirjautumislinkkien paluuosoite).
APP_BASE_URL=http://localhost:5173
# API:n julkinen osoite (latauslinkit). Supabase: https://<ref>.supabase.co/functions/v1
API_PUBLIC_URL=http://localhost:8787
# Muut sallitut käyttöliittymän osoitteet pilkulla eroteltuna (CORS).
CORS_ORIGINS=

# --- Käyttöliittymän koontiasetukset (julkisia, menevät selaimeen) -------------
# API:n osoite, jota käyttöliittymä kutsuu.
VITE_API_URL=http://localhost:8787
# Julkaisun alipolku, esim. /poliitikkoseuranta2/ GitHub Pagesissa tai / omalla verkkotunnuksella.
VITE_BASE_PATH=/

# --- Kirjautuminen ---------------------------------------------------------------
# supabase = Supabase Auth (sähköpostilinkki) | oidc = mikä tahansa OIDC-palvelu | dev = paikallinen kehitys
AUTH_PROVIDER=dev
# Sallitut sähköpostiosoitteet pilkulla eroteltuna. Muut eivät pääse sisään.
# Ensimmäinen kirjautuja saa ylläpitäjän roolin.
ALLOWED_EMAILS=admin@example.com
# dev-tilan tunnisteiden allekirjoitusavain (vähintään 32 merkkiä); setup luo automaattisesti.
# Vanhoissa Supabase-projekteissa (HS256) tähän voi laittaa projektin JWT-salaisuuden.
AUTH_JWT_SECRET=
# Supabase-projektin tiedot (Project Settings → API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role -avain: VAIN palvelimelle ja GitHub Secretsiin, ei koskaan selaimeen.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# OIDC (AUTH_PROVIDER=oidc): myöntäjä, JWKS-osoite, yleisö ja asiakastunnus.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=

# --- Salaus ----------------------------------------------------------------------
# Asetuksiin tallennettujen salaisuuksien (esim. tekoälyavaimet) salausavain, 32 tavua base64.
# setup luo automaattisesti. Älä hukkaa: ilman sitä tallennettuja avaimia ei voi lukea.
SETTINGS_ENCRYPTION_KEY=

# --- Tiedostojen tallennus -------------------------------------------------------
# supabase | local | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=poliitikkoseuranta
STORAGE_LOCAL_DIR=./.data/storage
# S3-yhteensopiva tallennus (AWS S3, Cloudflare R2, MinIO …)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Sähköposti ------------------------------------------------------------------
# supabase-auth (vain kirjautumislinkit) | resend | console (kirjoittaa lokiin)
MAIL_PROVIDER=console
MAIL_FROM=Poliitikkoseuranta <noreply@example.invalid>
RESEND_API_KEY=

# --- Taustatyöt --------------------------------------------------------------------
# github-actions = käynnistää .github/workflows/jobs.yml | inline = API-prosessissa | queue = erillinen työntekijä
JOBS_RUNNER=inline
# GitHub Actions -ajaja: repositorio (omistaja/repo), työnkulku, haara ja token (actions:write).
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_FILE=jobs.yml
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=

# --- Reaaliaikaiset ilmoitukset -----------------------------------------------------
# supabase = Supabase Realtime | polling = selain kysyy muutoksia muutaman sekunnin välein
REALTIME_PROVIDER=polling

# --- Tekoäly ---------------------------------------------------------------------
# Oletuspalvelu: anthropic | openai | openai-compatible | mock (valepalvelu ilman avainta).
# Tyhjä = anthropic, jos ANTHROPIC_API_KEY on asetettu, muuten openai tai mock.
# Asetuksia voi muuttaa käyttöliittymästä (Ylläpito → Tekoäly).
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-yhteensopiva tai oma malli (Ollama, vLLM, LM Studio …)
AI_BASE_URL=
AI_API_KEY=
# Upotemalli semanttiseen hakuun: openai | openai-compatible | mock
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Varmuuskopiot -----------------------------------------------------------------
# Kohde: s3 (suositus, eri tarjoaja kuin tuotanto) | local
BACKUP_TARGET=local
BACKUP_LOCAL_DIR=./backups
# Varmuuskopioiden salausavain, 32 tavua base64. Säilytä ERILLÄÄN varmuuskopioista
# (esim. salasanojen hallinnassa). Ilman sitä varmuuskopioita ei voi palauttaa.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Väliaikainen tietokanta kuukausittaiseen palautustestiin (tyhjennetään testissä).
BACKUP_VERIFY_DATABASE_URL=
# Ota varmuuskopio automaattisesti ennen migraatioita (true/false).
BACKUP_BEFORE_MIGRATE=true

# --- Tietolähteet ------------------------------------------------------------------
# Eduskunnan avoimen datan rajapinta (uusi api.eduskunta.fi; vanha avoindata.eduskunta.fi poistuu 2026 lopussa).
EDUSKUNTA_API_URL=https://api.eduskunta.fi/api/v1/
# Rajapinta vaatii User-Agent-otsakkeen; lisää yhteystieto, niin eduskunta voi ottaa yhteyttä.
EDUSKUNTA_USER_AGENT=Poliitikkoseuranta/2.0 (+https://github.com/)
# Pyyntöjen vähimmäisväli millisekunteina (nopeusrajoitus).
EDUSKUNTA_MIN_INTERVAL_MS=400
